# ===============================
# Target / Device
# ===============================
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_p2w_r619ac_128m=y

# ===============================
# LuCI
# ===============================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y

# ===============================
# IPv6 (WAN DHCPv6 client + LAN RA/DHCPv6 server + LuCI support)
# ===============================
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# 可选：Passwall/脚本若需要 ip6tables 兼容层再打开
CONFIG_PACKAGE_ip6tables-nft=y

# ===============================
# CPU frequency scaling
# ===============================
CONFIG_PACKAGE_kmod-cpufreq=y
CONFIG_PACKAGE_kmod-qcom-cpufreq=y
CONFIG_PACKAGE_cpufrequtils=y

# ===============================
# Passwall
# ===============================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_singbox=y
CONFIG_PACKAGE_sing-box=y

# ===============================
# Passwall firewall deps
# ===============================
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ===============================
# DNS helpers
# ===============================
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y

# ===============================
# Disabled heavy components
# ===============================
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_trojan-plus=n
CONFIG_PACKAGE_haproxy=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_v2ray-geoip=n
CONFIG_PACKAGE_v2ray-geosite=n

# ===============================
# LuCI themes
# ===============================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-kucat-config=y

# ===============================
# USB
# ===============================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y

# ===============================
# Tools and certificates
# ===============================
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y

# ===============================
# BusyBox options
# ===============================
CONFIG_BUSYBOX_DEFAULT_NOLOGIN=y
CONFIG_BUSYBOX_DEFAULT_FEATURE_SH_IS_NONE=y

# ===============================
# Keep dependencies from being stripped
# ===============================
CONFIG_ALL_NONSHARED=y
